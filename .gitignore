# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
.build-venv/

# PyInstaller build artifacts
build/
dist/
*.spec.bak

# Vendored ffmpeg: the per-arch static binaries are committed via Git LFS so
# builds stay fully local (no third-party download). Only the arch-specific
# working copy the build generates (vendor/ffmpeg) is ignored.
vendor/*
!vendor/ffmpeg-arm64
!vendor/ffmpeg-x86_64

# Recorded audio + companion video (user content)
captures/*.wav
captures/*.mp4
captures/*.webm
rec_*.wav
idea_*.wav

# Persisted user settings (lives in $HOME normally, but ignore if copied here)
.idea_recorder.json

# macOS
.DS_Store

# Editor / harness tooling
.claude/
